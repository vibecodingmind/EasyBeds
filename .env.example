# Required in production (32+ characters). Generate with: openssl rand -hex 32
JWT_SECRET=
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Where SQLite + JSON snapshots are stored (mount a volume in production)
DATA_DIR=./data
SQLITE_PATH=./data/vanguard.sqlite

# Railway: attach a volume at /app/data. If DATA_DIR is unset, RAILWAY_VOLUME_MOUNT_PATH is used.

# Public URL of this deployment (CORS, links, OAuth callbacks)
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Seed / demo staff password applied to accounts that do not yet have a hash.
# Required on first boot. Do not commit a real password.
DEMO_PASSWORD=
DEMO_LOGIN_HINTS=true

# Optional: require ?token= for public iCal feeds
# ICAL_FEED_SECRET=

# Session lifetime in seconds (default 12 hours)
# JWT_TTL_SECONDS=43200

# Gemini AI (optional — AI features degrade without it)
GEMINI_API_KEY=

# Live integrations (optional — adapters stay in sandbox mode until set)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SENDGRID_API_KEY=
